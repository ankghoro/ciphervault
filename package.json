{
  "name": "ciphervault-task assessment",
  "version": "1.0.0",
  "private": true,
  "description": "CipherVault — NestJS + Nuxt 3 credential manager",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:seed": "docker compose exec backend npx ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
